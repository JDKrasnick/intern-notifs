flowchart LR
  subgraph GH["InternNotifsGreenhouse stack"]
    EB["EventBridge Scheduler<br/>every 30 minutes"] --> D["Dispatch Lambda<br/>published every 30 min · shadow every 3 hr<br/>30 second ceiling"]
    D --> Q["Greenhouse FIFO work queue<br/>one message per reviewed board"]

    Q --> W["Worker Lambda<br/>batch 10 · 4 groups per invocation<br/>max 4 invocations · 2 minute ceiling"]
    W --> R{"Registry status"}

    R -->|shadow| S["Shadow validation<br/>API shape · mapping · quality · links"]

    R -->|published| P["Catalog poller<br/>ETag · map · dedupe · validate"]

    W -->|failed record| Q
    Q -->|after 4 receives| DLQ["Greenhouse dead-letter queue<br/>14 day retention"]

    Q -. queue age .-> CW["CloudWatch alarms"]
    W -. invocation errors .-> CW
    DLQ -. visible messages .-> CW
  end

  subgraph MAIN["Existing retained data plane"]
    DB[("DynamoDB internships table<br/>jobs + isolated checkpoints")]
    UDB[("DynamoDB user table")]
    N["Matching user notifications"]
  end

  S --> SC["Shadow checkpoint<br/>no catalog jobs · no alerts"] --> DB
  P --> DB
  P --> UDB
  DB --> N

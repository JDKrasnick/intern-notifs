    "SourceFetchFailureGithubAlarmF2FA3103": {
      "Properties": {
        "AlarmDescription": "A github source failed its bounded retries repeatedly within fifteen minutes.",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "provider",
            "Value": "github",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "SourceFetchFailure",
        "Namespace": "InternNotifs/Ingestion",
        "Period": 900,
        "Statistic": "Sum",
        "Threshold": 3,
        "TreatMissingData": "notBreaching",
